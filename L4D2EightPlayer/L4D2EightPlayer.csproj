<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10 (1903+) and Windows 11, so the exe needs no runtime install. -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>L4D2-8P-Manager</AssemblyName>
    <RootNamespace>L4D2EightPlayer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- drawn by tools\make_icon.ps1 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>L4D2 8-Player Co-op Manager</Product>
    <Description>Installs, checks and launches an 8-player co-op setup for Left 4 Dead 2.</Description>
    <Copyright>MIT License</Copyright>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="components.json" LogicalName="components.json" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
    <!-- Oswald, Barlow and Rubik Dirt (SIL Open Font License, see Fonts\OFL-*.txt) -->
    <EmbeddedResource Include="Fonts\*.ttf" />
    <!-- Plugins written for this tool, compiled on install like the downloaded fixes -->
    <EmbeddedResource Include="Plugins\*.sp;Plugins\*.txt" LogicalName="plugins/%(Filename)%(Extension)" />
    <!-- The client HUD add-on, built by ..\HudAddon\build_addon.py -->
    <EmbeddedResource Include="Addon\l4d2_8p_hud.vpk" LogicalName="addon/l4d2_8p_hud.vpk" />
  </ItemGroup>

</Project>
