<Project Sdk="Microsoft.NET.Sdk">

  <!-- Joining-only companion app for friends of the host. Shares Core\ with the host manager. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>L4D2-8P-Join</AssemblyName>
    <RootNamespace>L4D2EightPlayer.Join</RootNamespace>
    <ApplicationManifest>..\L4D2EightPlayer\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\L4D2EightPlayer\Assets\app.ico</ApplicationIcon>
    <Product>L4D2 8-Player Co-op Join</Product>
    <Description>Checks and joins a friend's 8-player Left 4 Dead 2 game.</Description>
    <Copyright>MIT License</Copyright>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\L4D2EightPlayer\Core\*.cs" LinkBase="Core" />
    <Compile Include="..\L4D2EightPlayer\UI\Theme\*.cs" LinkBase="Theme" />
    <Compile Include="*.cs" />
    <EmbeddedResource Include="..\L4D2EightPlayer\components.json" LogicalName="components.json" />
    <EmbeddedResource Include="..\L4D2EightPlayer\Assets\app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="..\L4D2EightPlayer\Fonts\*.ttf" LinkBase="Fonts" />
    <EmbeddedResource Include="..\L4D2EightPlayer\Addon\l4d2_8p_hud.vpk" LogicalName="addon/l4d2_8p_hud.vpk" />
  </ItemGroup>

</Project>
